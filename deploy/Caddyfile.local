# Local Caddyfile for *.pad.test acceptance testing.
# Uses Caddy's internal CA instead of ACME so the stack works without public DNS.
{
	admin off
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}

(security_headers) {
	header {
		# HSTS is intentionally omitted in local mode; the internal CA must not be pinned.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(pad_auth) {
	forward_auth pad:8000 {
		uri /api/auth/verify
		header_up X-Original-Host {host}
		header_up X-Original-URI {uri}
		copy_headers X-Pad-User X-Pad-Roles X-Pad-Admin
	}
}

(upstream_timeouts) {
	transport http {
		dial_timeout 10s
		response_header_timeout 30s
	}
}

{$PAD_DOMAIN} {
	tls internal
	import security_headers
	header X-Frame-Options "SAMEORIGIN"
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	@pad_public path /api/auth/login* /api/auth/callback* /api/auth/status /api/auth/logout /api/auth/verify /assets/* /static/* /favicon.ico
	handle @pad_public {
		reverse_proxy pad:8000 {
			import upstream_timeouts
		}
	}

	handle {
		request_header -X-Pad-*
		import pad_auth
		reverse_proxy pad:8000 {
			import upstream_timeouts
		}
	}
}

{$CODER_DOMAIN} {
	tls internal
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	@coder_api path /api/v2/*
	handle @coder_api {
		request_header -X-Pad-*
		reverse_proxy coder:7080 {
			import upstream_timeouts
			header_up Cookie "(^|;\\s*){$SESSION_COOKIE_NAME}=[^;]*(;\\s*)?" "$1"
			header_up -X-Pad-*
		}
	}

	handle {
		request_header -X-Pad-*
		import pad_auth
		reverse_proxy coder:7080 {
			import upstream_timeouts
			header_up Cookie "(^|;\\s*){$SESSION_COOKIE_NAME}=[^;]*(;\\s*)?" "$1"
			header_up -X-Pad-*
		}
	}
}

{$AUTH_DOMAIN} {
	tls internal
	import security_headers
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	request_header -X-Pad-*

	@keycloak_public path /realms/* /resources/* /robots.txt
	handle @keycloak_public {
		reverse_proxy keycloak:8080 {
			import upstream_timeouts
			header_up Cookie "(^|;\\s*){$SESSION_COOKIE_NAME}=[^;]*(;\\s*)?" "$1"
		}
	}

	@admin_path path /admin*
	handle @admin_path {
		import pad_auth
		@admin_allowed {
			header X-Pad-Admin true
			remote_ip {$ADMIN_ALLOWLIST}
		}
		@not_admin not {
			header X-Pad-Admin true
			remote_ip {$ADMIN_ALLOWLIST}
		}
		respond @not_admin 403
		reverse_proxy @admin_allowed keycloak:8080 {
			import upstream_timeouts
			header_up Cookie "(^|;\\s*){$SESSION_COOKIE_NAME}=[^;]*(;\\s*)?" "$1"
			header_up -X-Pad-*
		}
	}

	handle {
		reverse_proxy keycloak:8080 {
			import upstream_timeouts
			header_up Cookie "(^|;\\s*){$SESSION_COOKIE_NAME}=[^;]*(;\\s*)?" "$1"
		}
	}
}
