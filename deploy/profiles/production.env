# Production profile.
# Override domains, allowlist and ACME email before deploying.

PROFILE=production

# === Public domains ===
PAD_DOMAIN=__CHANGE_ME__
AUTH_DOMAIN=__CHANGE_ME__
CODER_DOMAIN=__CHANGE_ME__
COOKIE_DOMAIN=__CHANGE_ME__

# === ACME / TLS ===
ACME_EMAIL=__CHANGE_ME__
CADDYFILE=deploy/Caddyfile

# === Application URLs ===
OIDC_SERVER_URL=__CHANGE_ME__
REDIRECT_URI=__CHANGE_ME__
FRONTEND_URL=__CHANGE_ME__
OIDC_INTERNAL_URL=http://keycloak:8080
CODER_URL=__CHANGE_ME__
CODER_INTERNAL_URL=http://coder:7080

# === OIDC client ===
OIDC_REALM=pad
OIDC_CLIENT_ID=pad
OIDC_CLIENT_SECRET=__CHANGE_ME__

# === PostgreSQL ===
POSTGRES_USER=pad
POSTGRES_DB=pad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_DB=keycloak

# === Coder ===
CODER_WORKSPACE_NAME=ubuntu
CODER_DB=coder

# === Pad runtime ===
API_WORKERS=1
SESSION_COOKIE_NAME=session_id
PAD_ALLOWED_ROLES=pad-user
# Restrict to operator CIDRs.
ADMIN_ALLOWLIST="__CHANGE_ME__"
TRUSTED_PROXY_IPS=172.28.0.2

# === Static asset paths inside the Pad container ===
STATIC_DIR=/app/frontend/dist
ASSETS_DIR=/app/frontend/dist/assets

# === Backup retention ===
BACKUP_RETENTION_DAYS=30
