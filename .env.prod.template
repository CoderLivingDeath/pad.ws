# Production environment template for the Caddy-auth gateway deployment.
# Copy to .env, fill every __CHANGE_ME__ value, and chmod 600 .env.
# This template contains no working secrets; startup fails fast if placeholders remain.

# === Public domains ===
# Required: fully-qualified domain for the Pad application.
PAD_DOMAIN=__CHANGE_ME__
# Required: fully-qualified domain for Keycloak / OIDC issuer.
AUTH_DOMAIN=__CHANGE_ME__
# Required: fully-qualified domain for Coder.
CODER_DOMAIN=__CHANGE_ME__
# Required: shared registrable parent domain for the three hosts (e.g. .example.com).
COOKIE_DOMAIN=__CHANGE_ME__

# === ACME / TLS ===
# Optional: email address for ACME account and certificate expiry notices.
ACME_EMAIL=__CHANGE_ME__
# Required: Caddyfile for this profile (production uses the ACME file).
CADDYFILE=deploy/Caddyfile

# === Application URLs ===
# Required: public OIDC issuer URL (https://auth.example.com).
OIDC_SERVER_URL=__CHANGE_ME__
# Required: exact redirect URI registered in Keycloak for Pad.
REDIRECT_URI=__CHANGE_ME__
# Required: public URL of the Pad frontend (https://pad.example.com).
FRONTEND_URL=__CHANGE_ME__
# Optional: internal token/JWKS URL (leave empty to use OIDC_SERVER_URL).
OIDC_INTERNAL_URL=
# Required: public Coder URL used by the frontend and workspace base_url.
CODER_URL=__CHANGE_ME__
# Optional: internal Coder API URL (leave empty to use CODER_URL).
CODER_INTERNAL_URL=

# === OIDC client ===
# Required: Keycloak realm name.
OIDC_REALM=__CHANGE_ME__
# Required: Keycloak client ID for Pad/Coder.
OIDC_CLIENT_ID=__CHANGE_ME__
# Required: Keycloak client secret for the confidential client.
OIDC_CLIENT_SECRET=__CHANGE_ME__

# === PostgreSQL ===
# Required: database owner username.
POSTGRES_USER=__CHANGE_ME__
# Required: generated database password.
POSTGRES_PASSWORD=__CHANGE_ME__
# Required: name of the Pad database.
POSTGRES_DB=pad
# Optional: service name of the PostgreSQL server inside the compose network.
POSTGRES_HOST=postgres
# Optional: PostgreSQL port inside the compose network.
POSTGRES_PORT=5432

# === Redis ===
# Required: generated Redis password.
REDIS_PASSWORD=__CHANGE_ME__
# Optional: service name of the Redis server inside the compose network.
REDIS_HOST=redis
# Optional: Redis port inside the compose network.
REDIS_PORT=6379

# === Keycloak ===
# Required: Keycloak admin username.
KEYCLOAK_ADMIN=admin
# Required: generated Keycloak admin password.
KEYCLOAK_ADMIN_PASSWORD=__CHANGE_ME__
# Required: database name for Keycloak.
KEYCLOAK_DB=keycloak

# === Coder ===
# Required: Coder admin / provisioner API key.
CODER_API_KEY=__CHANGE_ME__
# RFC-3339 timestamp recorded when CODER_API_KEY was created; status warns at 6 days.
CODER_API_KEY_CREATED_AT=
# Required: Coder template UUID for workspace creation.
CODER_TEMPLATE_ID=__CHANGE_ME__
# Required: Coder organization UUID that owns the template.
CODER_DEFAULT_ORGANIZATION=__CHANGE_ME__
# Optional: default workspace name used for new users.
CODER_WORKSPACE_NAME=ubuntu
# Required: database name for Coder.
CODER_DB=coder
# Required: URL-encoded database password for Coder (use the same value as POSTGRES_PASSWORD).
CODER_DB_PASSWORD_URLENCODED=__CHANGE_ME__
# Required: host group ID that owns /var/run/docker.sock (run: getent group docker | cut -d: -f3).
DOCKER_GROUP_ID=__CHANGE_ME__

# === Pad runtime ===
# Optional: number of Uvicorn workers.
API_WORKERS=1
# Optional: name of the session cookie shared across subdomains.
SESSION_COOKIE_NAME=session_id
# Required: comma-separated Keycloak realm roles required for Pad access.
PAD_ALLOWED_ROLES=pad-user
# Required: space-separated CIDRs allowed to reach /admin. Must not be 0.0.0.0/0 ::/0 in production.
ADMIN_ALLOWLIST="__CHANGE_ME__"
# Caddy static address on the edge network (see docker-compose.prod.yml).
TRUSTED_PROXY_IPS=172.28.0.2

# === Pinned images (override with values from deploy/releases/<version>.json) ===
CADDY_IMAGE=__CHANGE_ME__
POSTGRES_IMAGE=__CHANGE_ME__
REDIS_IMAGE=__CHANGE_ME__
KEYCLOAK_IMAGE=__CHANGE_ME__
CODER_IMAGE=__CHANGE_ME__
PAD_IMAGE=__CHANGE_ME__

# === Backup retention ===
BACKUP_RETENTION_DAYS=30

# === Static asset paths inside the Pad container ===
STATIC_DIR=/app/frontend/dist
ASSETS_DIR=/app/frontend/dist/assets
