# Local acceptance environment template for *.pad.test with Caddy's internal CA.
# Copy to .env, fill every __CHANGE_ME__ value, and add the three domains to /etc/hosts:
#   127.0.0.1 pad.pad.test auth.pad.test coder.pad.test

# === Local topology ===
# Required: use the local Caddyfile with tls internal.
CADDYFILE=deploy/Caddyfile.local

# === Public domains (local) ===
PAD_DOMAIN=pad.pad.test
AUTH_DOMAIN=auth.pad.test
CODER_DOMAIN=coder.pad.test
COOKIE_DOMAIN=.pad.test

# === ACME / TLS ===
# Optional: email is not required for the internal CA but kept for consistency.
ACME_EMAIL=local@pad.test

# === Application URLs ===
OIDC_SERVER_URL=https://auth.pad.test
REDIRECT_URI=https://pad.pad.test/api/auth/callback
FRONTEND_URL=https://pad.pad.test
OIDC_INTERNAL_URL=http://keycloak:8080
CODER_URL=https://coder.pad.test
CODER_INTERNAL_URL=http://coder:7080

# === OIDC client ===
OIDC_REALM=pad
OIDC_CLIENT_ID=pad
OIDC_CLIENT_SECRET=pad-test-secret

# === PostgreSQL ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=pad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === Redis ===
REDIS_PASSWORD=__CHANGE_ME__
REDIS_HOST=redis
REDIS_PORT=6379

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__CHANGE_ME__
KEYCLOAK_DB=keycloak

# === Coder ===
CODER_API_KEY=__CHANGE_ME__
# RFC-3339 timestamp recorded when CODER_API_KEY was created; status warns at 6 days.
CODER_API_KEY_CREATED_AT=
CODER_TEMPLATE_ID=__CHANGE_ME__
CODER_DEFAULT_ORGANIZATION=__CHANGE_ME__
CODER_WORKSPACE_NAME=ubuntu
CODER_DB=coder
CODER_DB_PASSWORD_URLENCODED=__CHANGE_ME__
DOCKER_GROUP_ID=__CHANGE_ME__

# === Pad runtime ===
API_WORKERS=1
SESSION_COOKIE_NAME=session_id
# Required: comma-separated Keycloak realm roles required for Pad access.
PAD_ALLOWED_ROLES=pad-user
# Open allowlist for local testing only; restrict in production.
ADMIN_ALLOWLIST="0.0.0.0/0 ::/0"
# Caddy static address on the edge network (see docker-compose.prod.yml).
TRUSTED_PROXY_IPS=172.28.0.2

# === Pinned images (local defaults from deploy/releases/) ===
CADDY_IMAGE=caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
POSTGRES_IMAGE=postgres:16@sha256:63e83b5a3dc36a917dccb76fe1bd2ac51f1ec9c1deb47ff20d4f04233bf6eae9
REDIS_IMAGE=redis:7.2-alpine@sha256:a2c8f9d7c49c74ebd2945e3798c71606545c5f0d90d03e9ec4a2bb8d4f56df36
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0@sha256:82c5b7a110456dbd42b86ea572e728878549954cc8bd03cd65410d75328095d2
CODER_IMAGE=ghcr.io/coder/coder:latest@sha256:77500de63a62f733bb1fbbf79da85e8ad4d6ca582e964f5d6021f46f6dc7fc29
# Local mode builds Pad from the working tree; deploy.sh sets this to pad-ws:test@<digest>.
PAD_IMAGE=pad-ws:test

# === Static asset paths inside the Pad container ===
STATIC_DIR=/app/frontend/dist
ASSETS_DIR=/app/frontend/dist/assets
