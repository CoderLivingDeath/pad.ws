#!/usr/bin/env sh
set -eu

message_file=$1
first_line=$(sed -n '1p' "$message_file")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._/-]+\))?!?: .+"

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  cat >&2 <<'EOF'
commit-msg: commit message does not follow Conventional Commits.

  <type>(optional scope): <subject>

  types: feat fix docs style refactor perf test build ci chore revert
  example: feat(auth): add verify endpoint
EOF
  exit 1
fi

if [ "${#first_line}" -gt 100 ]; then
  echo "commit-msg: first line must be 100 characters or fewer." >&2
  exit 1
fi
